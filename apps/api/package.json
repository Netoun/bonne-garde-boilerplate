{
  "name": "@bonne-garde/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 5172",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test run --coverage",
    "auth:generate": "bunx auth@latest generate --config ./src/modules/auth/auth.config.ts --output ./src/modules/db/schemas/db.auth-schema.ts --adapter drizzle --dialect sqlite --yes",
    "auth:secret": "bunx auth@latest secret",
    "db:generate": "drizzle-kit generate --config ./src/modules/db/db.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply my-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply my-app-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/modules/db/db.seed.ts",
    "db:reset": "wrangler d1 execute my-app-db --local --command=\"DELETE FROM member; DELETE FROM invitation; DELETE FROM session; DELETE FROM account; DELETE FROM medias; DELETE FROM organization; DELETE FROM user;\" && bun run db:seed",
    "db:seed:data": "bun run src/modules/db/db.seed.ts"
  },
  "dependencies": {
    "@bonne-garde/emails": "workspace:*",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@elysiajs/cookie": "0.8.0",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/eden": "1.4.9",
    "@libsql/client": "0.17.4",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "elysia": "1.4.29",
    "qrcode": "1.5.4",
    "resend": "6.17.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260708.1",
    "@types/bun": "latest",
    "@types/react": "19.2.17",
    "@types/node": "26.1.1",
    "@types/qrcode": "1.5.6",
    "bun-types": "1.3.14",
    "drizzle-kit": "0.31.10",
    "miniflare": "4.20260706.0",
    "module-alias": "2.3.4",
    "tsx": "4.23.0",
    "wrangler": "4.107.1"
  },
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./lib/app.config": "./src/lib/app.config.ts",
    "./lib/env": "./src/lib/env.ts",
    "./lib/email": "./src/lib/email.ts",
    "./lib/r2": "./src/lib/r2.ts",
    "./lib/slug": "./src/lib/slug.ts",
    "./modules/db/db.client": "./src/modules/db/db.client.ts",
    "./modules/db/db.service": "./src/modules/db/db.service.ts",
    "./modules/db/db.config": "./src/modules/db/db.config.ts",
    "./modules/db/db.module": "./src/modules/db/db.module.ts",
    "./modules/db/schemas/db.auth-schema": "./src/modules/db/schemas/db.auth-schema.ts",
    "./modules/auth/auth.macro": "./src/modules/auth/auth.macro.ts",
    "./modules/auth/auth.config": "./src/modules/auth/auth.config.ts",
    "./modules/auth/auth.module": "./src/modules/auth/auth.module.ts",
    "./modules/*": "./src/modules/*"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
