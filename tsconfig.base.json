{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@acme/api/*": ["./apps/api/src/*"],
      "@acme/config": ["./packages/config/src/index.ts"],
      "@acme/config/*": ["./packages/config/src/*"]
    }
  }
}
