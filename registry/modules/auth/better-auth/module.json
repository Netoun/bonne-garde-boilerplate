{
  "$schema": "https://bonne-garde.dev/schema/module.json",
  "id": "better-auth",
  "category": "auth",
  "version": "0.1.0",
  "title": "Better Auth",
  "description": "Session auth with email and password, email verification and organizations, over the installed database.",
  "peers": { "provider": [], "api": [], "db": ["d1"], "orm": ["drizzle"] },
  "checks": ["cd packages/auth && bun run typecheck && bun run test"],
  "variants": [
    {
      "key": "default",
      "match": {},
      "workspace": { "name": "{{SCOPE}}/auth", "path": "packages/auth" },
      "dependencies": {
        "@better-auth/drizzle-adapter": "1.6.26",
        "better-auth": "1.6.26",
        "drizzle-orm": "0.45.2",
        "elysia": "1.4.29",
        "{{SCOPE}}/api": "workspace:*",
        "{{SCOPE}}/api-runtime": "workspace:*",
        "{{SCOPE}}/db": "workspace:*"
      },
      "copy": [
        "packages/auth/package.json",
        "packages/auth/src/auth.cli.test.ts",
        "packages/auth/src/auth.cli.ts",
        "packages/auth/src/auth.config.test.ts",
        "packages/auth/src/auth.config.ts",
        "packages/auth/src/auth.flow.test.ts",
        "packages/auth/src/auth.module.ts",
        "packages/auth/src/auth.rate-limit.test.ts",
        "packages/auth/src/auth.schema.test.ts",
        "packages/auth/src/client.ts",
        "packages/auth/src/env.test.ts",
        "packages/auth/src/env.ts",
        "packages/auth/src/exports.test.ts",
        "packages/auth/src/index.ts",
        "packages/auth/src/mailer.test.ts",
        "packages/auth/src/mailer.ts",
        "packages/auth/src/password.test.ts",
        "packages/auth/src/password.ts",
        "packages/auth/src/schema.ts",
        "packages/auth/src/testing.ts",
        "packages/auth/tsconfig.json",
        "packages/auth/tsconfig.test.json"
      ],
      "env": [{ "name": "BETTER_AUTH_SECRET", "required": true, "example": "" }]
    }
  ]
}
