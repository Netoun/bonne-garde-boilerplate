{
  "name": "acme",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "build": "bun run --parallel --filter '*' build",
    "typecheck": "bun run typecheck:scripts && bun run --parallel --filter '*' typecheck",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "test": "bun run test:scripts && bun run --parallel --filter '*' test",
    "test:scripts": "bun test scripts",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build",
    "ui": "bun run --filter '@acme/ui' registry",
    "prepare": "husky",
    "gen:commands": "bun scripts/gen-commands.ts",
    "gen:architecture": "bun scripts/gen-architecture.ts",
    "gen:branding": "bun scripts/gen-branding.ts",
    "brand": "bun scripts/brand.ts",
    "init": "bun scripts/init.ts"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "knip": "6.32.0",
    "msw": "2.15.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "elysia": "1.4.29",
    "kysely": "0.29.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.11",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  }
}
